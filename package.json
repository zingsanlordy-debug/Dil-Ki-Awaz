{
  "name": "zq-feelings-dil-ki-awaaz",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "sitemap": "tsx scripts/generate-sitemap.ts",
    "build": "tsx scripts/generate-sitemap.ts && NODE_OPTIONS=--max-old-space-size=1536 vite build && node scripts/postbuild-seo.mjs",
    "build:static": "FULL_STATIC_PRERENDER=true tsx scripts/generate-sitemap.ts && NODE_OPTIONS=--max-old-space-size=1536 vite build && FULL_STATIC_PRERENDER=true node scripts/postbuild-seo.mjs",
    "preview": "vite preview --port=3000 --host=0.0.0.0",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "lint:rules": "eslint firestore.rules"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@tensorflow/tfjs": "^4.22.0",
    "@vercel/analytics": "^1.3.1",
    "@vitejs/plugin-react": "^5.0.4",
    "bad-words": "^4.0.0",
    "buffer": "^6.0.3",
    "express": "^4.21.2",
    "firebase": "^12.4.0",
    "lucide-react": "^0.546.0",
    "nsfwjs": "4.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.19.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.22.0",
    "typescript": "~5.8.2"
  }
}