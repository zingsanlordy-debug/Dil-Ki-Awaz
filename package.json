{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "sitemap": "tsx scripts/generate-sitemap.ts",
    "build": "tsx scripts/generate-sitemap.ts && NODE_OPTIONS=--max-old-space-size=4096 vite build && node scripts/postbuild-seo.mjs",
    "build:static": "tsx scripts/generate-sitemap.ts && FULL_STATIC_PRERENDER=true NODE_OPTIONS=--max-old-space-size=4096 vite build && FULL_STATIC_PRERENDER=true node scripts/postbuild-seo.mjs",
    "start": "node server.ts",
    "preview": "vite preview --host=0.0.0.0",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tensorflow/tfjs": "^4.22.0",
    "@vitejs/plugin-react": "^6.1.1",
    "bad-words": "^4.1.5",
    "buffer": "^6.0.3",
    "express": "^4.21.2",
    "firebase": "^13.1.0",
    "lucide-react": "^0.546.0",
    "nsfwjs": "^4.4.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "typescript": "$typescript"
  }
}
