# GEMINI_API_KEY: Optional (not required for live ZQ Feelings Shayari website).
# AI Studio automatically injects this at runtime if needed.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted in AI Studio / Cloud Run.
APP_URL="MY_APP_URL"

# SITE_URL & VITE_SITE_URL: Optional custom domain override (e.g. https://zqfeelings.com or https://zqfeelings.in).
# Automatically detected at runtime on custom domains; set during static builds if using .in instead of .com.
SITE_URL="https://zqfeelings.com"
VITE_SITE_URL="https://zqfeelings.com"
